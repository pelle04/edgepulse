{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ModbusAdapter": {
    "Host": "simulator",
    "Port": 502,
    "SlaveId": 1,
    "DeviceId": "plc-01",
    "PollIntervalMs": 2000,
    "RegisterMap": [
      { "Address": 0, "MetricName": "temperature", "Unit": "C", "ScaleFactor": 10 },
      { "Address": 1, "MetricName": "pressure", "Unit": "hPa", "ScaleFactor": 10 }
    ]
  },
  "MqttAdapter": {
    "Host": "mosquitto",
    "Port": 1883,
    "TopicFilter": "edgepulse/sensors/+/reading"
  },
  "BufferWriter": {
    "ConnectionString": "Data Source=/data/edgepulse.db"
  }
}
